<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sumin.knowledgearchive.material.MaterialMapper">
    <resultMap id="materialResultMap" type="com.sumin.knowledgearchive.material.MaterialDomain">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="memo" column="memo"/>
        <result property="url" column="url"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="userId" column="user_id"/>

        <collection property="tags" ofType="com.sumin.knowledgearchive.tag.TagDomain">
            <id property="id" column="tag_id"/>
            <result property="name" column="tag_name"/>
            <result property="createdAt" column="created_at"/>
            <result property="updatedAt" column="updated_at"/>
        </collection>
    </resultMap>


    <select id="selectMaterials" parameterType="String" resultMap="materialResultMap">
        SELECT
            m.id
            ,m.title
            ,m.memo
            ,m.url
            ,t.id AS tag_id
            ,t.name AS tag_name
            ,m.created_at
            ,m.updated_at
            ,m.user_id
        FROM "MATERIAL" m
        LEFT JOIN "MATERIAL_TAG" mt
            ON m.id = mt.material_id
        LEFT JOIN "TAG" t
            ON t.id = mt.tag_id
        <where>
            <if test="title != null and title != ''">
                title LIKE '%' || #{title} || '%'
            </if>
        </where>
    </select>

    <insert id="insertMaterial" parameterType="com.sumin.knowledgearchive.material.MaterialDomain"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO "MATERIAL"
            (
            title
            ,memo
            ,url
            ,user_id
            )
        VALUES
            (
            #{title}
            ,#{memo}
            ,#{url}
            ,#{userId}
            )
    </insert>

    <select id="selectMaterialById" parameterType="int" resultMap="materialResultMap">
        SELECT
            m.id
            ,m.title
            ,m.memo
            ,m.url
            ,t.id AS tag_id
            ,t.name AS tag_name
            ,m.created_at
            ,m.updated_at
            ,m.user_id
        FROM "MATERIAL" m
        LEFT JOIN "MATERIAL_TAG" mt
            ON m.id = mt.material_id
        LEFT JOIN "TAG" t
            ON t.id = mt.tag_id
        WHERE m.id = #{id}
    </select>

    <update id="updateMaterial" parameterType="com.sumin.knowledgearchive.material.MaterialDomain">
        UPDATE
            "MATERIAL"
        SET
            title = #{title}
            , memo = #{memo}
            , url = #{url}
            , updated_at = CURRENT_TIMESTAMP
        WHERE id= #{id}
    </update>

    <delete id="deleteMaterial" parameterType="int">
        DELETE
            FROM "MATERIAL"
        WHERE id = #{id}
    </delete>
</mapper>