<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sumin.knowledgearchive.material.MaterialMapper">
    <select id="selectMaterials" parameterType="String" resultType="com.sumin.knowledgearchive.material.MaterialDomain">
        SELECT
        id
        ,title
        ,memo
        ,url
        ,created_at
        ,updated_at
        ,user_id
        FROM "MATERIAL"
        <where>
            <if test="title != null and title != ''">
                title LIKE '%' || #{title} || '%'
            </if>
        </where>
    </select>

    <insert id="insertMaterial" parameterType="com.sumin.knowledgearchive.material.MaterialDomain">
        INSERT INTO "MATERIAL"
            (
            title
            ,memo
            ,url
            ,user_id
            )
        VALUES
            (
            #{title}
            ,#{memo}
            ,#{url}
            ,#{userId}
            )
    </insert>

    <select id="selectMaterialById" parameterType="int" resultType="com.sumin.knowledgearchive.material.MaterialDomain">
        SELECT
            id
            , title
            , memo
            , url
            , created_at
            , updated_at
            , user_id
        FROM "MATERIAL"
        WHERE id = #{id}
    </select>

    <update id="updateMaterial" parameterType="com.sumin.knowledgearchive.material.MaterialDomain">
        UPDATE
            "MATERIAL"
        SET
            title = #{title}
            , memo = #{memo}
            , url = #{url}
            , updated_at = CURRENT_TIMESTAMP
        WHERE id= #{id}
    </update>

    <delete id="deleteMaterial" parameterType="int">
        DELETE
            FROM "MATERIAL"
        WHERE id = #{id}
    </delete>
</mapper>