<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sumin.knowledgearchive.user.UserMapper">

    <select id="selectAllUser" resultType="com.sumin.knowledgearchive.user.UserDomain">
        SELECT
            id
            ,email
            ,password
            ,created_at
        FROM
            "USER"
    </select>

    <insert id="insertUser" parameterType="com.sumin.knowledgearchive.user.UserDomain">
        INSERT INTO "USER"
            (
            email
            ,password
            )
        VALUES
            (
            #{email}
            ,#{password}
            )
    </insert>

</mapper>